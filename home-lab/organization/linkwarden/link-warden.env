# postgres
POSTGRES_PASSWORD=<<REPLACE_WITH_REAL_POSTGRES_PASSWORD>>

# linkwarden
# Must be the canonical public hostname (see connection/Caddyfile) —
# update this if links.semicolon42.com ever stops being canonical.
NEXTAUTH_URL=http://localhost:3000/api/v1/auth
NEXTAUTH_SECRET=<<REPLACE_WITH_REAL_NEXTAUTH_SECRET>>
# Must match POSTGRES_PASSWORD above exactly.
DATABASE_URL=postgresql://postgres:<<REPLACE_WITH_REAL_POSTGRES_PASSWORD>>@postgres:5432/postgres
