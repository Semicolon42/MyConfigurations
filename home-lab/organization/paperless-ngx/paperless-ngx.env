TZ=America/Los_Angeles

# postgres
POSTGRES_DB=paperless
POSTGRES_USER=__REPLACE_ME_DB_USER__
POSTGRES_PASSWORD=__REPLACE_ME_DB_PASS__

# paperless-ngx (DB vars must match postgres above; TIKA/GOTENBERG endpoints
# use their internal container ports, unaffected by host port renumbering)
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_TIME_ZONE=America/Los_Angeles
PAPERLESS_DBHOST=postgres
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=__REPLACE_ME_DB_USER__
PAPERLESS_DBPASS=__REPLACE_ME_DB_PASS__
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
PAPERLESS_SECRET_KEY=__REPLACE_ME_PAPERLESS_SECRET_KEY__

# paperless-ngx admin account (auto-created on first start if DB is empty)
PAPERLESS_ADMIN_USER=__REPLACE_ME_ADMIN_USER__
PAPERLESS_ADMIN_PASSWORD=__REPLACE_ME_ADMIN_PASS__
PAPERLESS_ADMIN_MAIL=__REPLACE_ME_ADMIN_EMAIL__

# paperless-ai (PAPERLESS_API_TOKEN is shared with paperless-gpt below)
PAPERLESS_API_URL=http://paperless-ngx:8000/api
PAPERLESS_API_TOKEN=__PAPERLESS_ADMIN_API_TOKEN__
PAPERLESS_USERNAME=__PAPERLESS_ADMIN_USERNAME__
AI_PROVIDER=ollama
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_ENABLED=true
SCAN_INTERVAL=*/30 * * * *
PAPERLESS_URL=http://paperless-ngx:8000

# paperless-gpt
PAPERLESS_BASE_URL=http://paperless-ngx:8000
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_HOST=http://ollama:11434
OLLAMA_CONTEXT_LENGTH=8192
TOKEN_LIMIT=1000
LLM_LANGUAGE=English
OCR_PROVIDER=llm
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=minicpm-v:8b
AUTO_OCR_TAG=paperless-gpt-ocr-auto
AUTO_TAG=paperless-gpt-auto
MANUAL_TAG=paperless-gpt-manual
PDF_OCR_TAGGING=true
PDF_OCR_COMPLETE_TAG=paperless-gpt-ocr-complete
PDF_UPLOAD=false
LOG_LEVEL=debug
