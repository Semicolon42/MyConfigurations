TZ=America/Los_Angeles

# postgres
POSTGRES_DB=paperless
POSTGRES_USER=__REPLACE_ME_DB_USER__
POSTGRES_PASSWORD=__REPLACE_ME_DB_PASS__

# paperless-ngx (DB vars must match postgres above; TIKA/GOTENBERG endpoints
# use their internal container ports, unaffected by host port renumbering)
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_TIME_ZONE=America/Los_Angeles
PAPERLESS_DBHOST=postgres
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=__REPLACE_ME_DB_USER__
PAPERLESS_DBPASS=__REPLACE_ME_DB_PASS__
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
PAPERLESS_SECRET_KEY=__REPLACE_ME_PAPERLESS_SECRET_KEY__

# Required because paperless-ngx is reverse-proxied at a different host
# (docs.semicolon42.com via Caddy/Cloudflare, see caddy/Caddyfile) than its
# internal container address — without this, login POSTs fail CSRF checks
# since Django only trusts the origins listed here.
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://docs.semicolon42.com

# paperless-ngx admin account (auto-created on first start if DB is empty)
PAPERLESS_ADMIN_USER=__REPLACE_ME_ADMIN_USER__
PAPERLESS_ADMIN_PASSWORD=__REPLACE_ME_ADMIN_PASS__
PAPERLESS_ADMIN_MAIL=__REPLACE_ME_ADMIN_EMAIL__

# paperless-ngx-dedupe (reuses PAPERLESS_URL/PAPERLESS_API_TOKEN above)
# Required because it's reverse-proxied at a different host
# (docs-dd.semicolon42.com via Caddy/Cloudflare) than its internal container
# address — SvelteKit's CSRF protection 403s POST requests whose Origin
# doesn't match this.
ORIGIN=https://docs-dd.semicolon42.com
# Optional AI-assisted metadata suggestions are off by default; to enable,
# uncomment and set AI_OPENAI_API_KEY.
# AI_ENABLED=false
# AI_OPENAI_API_KEY=
